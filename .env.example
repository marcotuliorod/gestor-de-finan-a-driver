# Copie para .env e preencha antes de rodar `docker compose up`
POSTGRES_PASSWORD=change-me
# Senha da role de baixo privilégio (driver_finance_app) usada pelo pool de
# runtime da API — é o que faz o RLS por usuário valer de verdade (a role
# dona das tabelas, acima, ignora RLS). Nunca reutilize a mesma senha.
APP_DB_PASSWORD=change-me-too-different-from-postgres-password
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Confirme o bundle id real gerado em ios/Runner.xcodeproj (o macOS usa
# com.marcotuliorod.driverFinance — o Android usa com.marcotuliorod.driver_finance,
# nomes diferentes entre plataformas neste projeto).
APPLE_BUNDLE_ID=com.marcotuliorod.driverFinance
CORS_ORIGINS=*
# Chave da API da Anthropic (console.anthropic.com) — usada pelo chat IA.
# Nunca é enviada ao Flutter, fica só no container da API.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Só usado em produção (docker-compose.prod.yml, serviço Caddy) — domínio
# real que aponta (registro DNS tipo A) para o IP do VPS. Enquanto não
# tiver um domínio, deixe o placeholder: a Caddy só emite certificado
# HTTPS de verdade quando o domínio resolve para o servidor.
DOMAIN=api.example.com
